	(text "SAFEBOAT TERMICA v2  —  camera termica MLX90640 110 + ESP32-C3, 8-32 V do barco, 4 camadas  ·  esquematico p/ revisao"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4cd7846f-3239-436d-b7ec-fa94f8fd3bd3")
	)
	(text "Redes por label (mesma netlist pino a pino de make_board.py). Placa 40 x 40 mm, 4 camadas (In1 GND, In2 3V3); sensor no lado B (frente), resto no lado F (re). Montagem completa JLCPCB (2 lados)."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2b7cf8c8-180f-493b-aae3-f7443134e91d")
	)
	(text "1 · ALIMENTACAO — +8-32 V (pads P1/P2, fio soldado) -> F1 PPTC 0,5 A -> D1 TVS SMBJ33A -> D2 SS34 (inversao) -> VIN -> U2 MP4560 (500 kHz, EN flutuante = liga) -> L1 10 uH / D4 SS36 -> 3V3 (FB 47k/15k)  ·  USB J1 -> D3 SS14 -> VIN  ·  R7/R8 leem VIN/23 no ADC (GPIO0)"
		(exclude_from_sim no)
		(at 20 40 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2bcf7900-68c7-4f1d-8778-c97994f5e8ce")
	)
